---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Imagem para PDF | ArquivoPronto" description="Junte uma ou mais imagens JPG, PNG e outros formatos em um único PDF gratuito, diretamente no navegador.">
  <div class="tool-heading"><span class="eyebrow">Conversão de arquivos</span><h1 class="page-title">Imagem para PDF</h1><p class="lead">Transforme fotos e imagens em um documento PDF. Selecione vários arquivos para reunir tudo em um único documento, com uma imagem por página.</p></div>
  <section class="tool-panel">
    <div class="panel-intro"><span class="panel-step">1</span><div><strong>Escolha suas imagens</strong><p>Selecione uma ou mais imagens do seu dispositivo. A ordem escolhida será mantida no PDF.</p></div></div>
    <label class="file-picker" for="files"><span class="upload-symbol">↑</span><strong>Selecionar imagens</strong><span>JPG, PNG, WebP e outros formatos compatíveis com seu navegador</span><input id="files" type="file" accept="image/*" multiple /></label>
    <div id="preview" class="file-preview muted" aria-live="polite">Nenhuma imagem selecionada.</div>
    <button id="convert" disabled>Converter e baixar PDF <span aria-hidden="true">→</span></button>
    <p id="status" class="status muted" aria-live="polite"></p>
    <p class="privacy-hint">O processamento é realizado no navegador. As imagens selecionadas não precisam ser enviadas a um servidor para esta conversão.</p>
  </section>
  <section class="info-grid"><article><span class="eyebrow">Como usar</span><h2>Crie seu PDF em três passos</h2><ol><li>Selecione as imagens que deseja reunir.</li><li>Confira os nomes e a ordem dos arquivos selecionados.</li><li>Clique em “Converter e baixar PDF”. O documento será salvo no seu dispositivo.</li></ol></article><article><span class="eyebrow">Entenda o resultado</span><h2>O que acontece com as imagens?</h2><p>Cada imagem selecionada é colocada em uma página A4, centralizada e ajustada para caber na página sem distorcer suas proporções. O arquivo final é um PDF com uma página para cada imagem.</p></article></section>
  <section class="related-tools" aria-labelledby="related-title">
    <span class="eyebrow">Continue com outras ferramentas</span>
    <h2 id="related-title">O que mais você pode fazer com suas imagens?</h2>
    <ul>
      <li><a href="/comprimir-imagem/">Comprimir imagem online</a> para reduzir o tamanho do arquivo antes de compartilhar.</li>
      <li><a href="/redimensionar-imagem/">Redimensionar imagem em pixels</a> para ajustar largura e altura.</li>
      <li><a href="/qr-code/">Gerar um QR Code</a> para compartilhar um link ou uma mensagem.</li>
    </ul>
  </section>
  <section class="faq"><h2>Perguntas frequentes</h2><details><summary>Posso selecionar várias imagens?</summary><p>Sim. Use a seleção múltipla do seu dispositivo para escolher várias imagens. Cada arquivo será inserido em uma página do PDF.</p></details><details><summary>As imagens serão cortadas?</summary><p>A ferramenta ajusta cada imagem para caber na página A4, preservando sua proporção. Isso pode deixar margens em branco quando a proporção da imagem for diferente da página.</p></details><details><summary>Quais formatos posso usar?</summary><p>A ferramenta aceita arquivos reconhecidos pelo navegador como imagem. JPG e PNG são formatos comuns. A compatibilidade de outros formatos depende do navegador e do dispositivo.</p></details><details><summary>Por que a conversão pode falhar?</summary><p>Imagens muito grandes ou em formatos não suportados podem consumir muita memória ou não abrir. Tente utilizar imagens menores ou convertê-las para JPG ou PNG antes de repetir.</p></details></section>
  <style>
    .related-tools{margin-top:30px;padding:23px 25px;border:1px solid #dbeafe;border-radius:17px;background:#f8fbff}
    .related-tools h2{font-size:1.25rem;line-height:1.3;margin:8px 0 12px;color:#172554}
    .related-tools ul{display:grid;gap:9px;margin:0;padding-left:20px;color:#64748b}
    .related-tools li{padding-left:3px}
    .related-tools a{font-weight:700;color:#1d4ed8}
  </style>
  <style>
    .tool-heading{max-width:780px}.tool-panel{margin-top:28px;padding:28px;border:1px solid #dbeafe;border-radius:22px;background:linear-gradient(180deg,#f8fbff,#fff);box-shadow:0 12px 36px #0f172a08;display:grid;gap:18px}.panel-intro{display:flex;gap:13px;align-items:flex-start}.panel-step{display:grid;place-items:center;flex:0 0 34px;height:34px;background:#dbeafe;color:#1d4ed8;border-radius:10px;font-weight:800}.panel-intro p{margin:3px 0 0;color:#64748b;font-size:.94rem}.file-picker{display:grid;justify-items:center;gap:7px;padding:30px 18px;border:1.5px dashed #93c5fd;border-radius:16px;background:#fff;text-align:center;cursor:pointer}.upload-symbol{display:grid;place-items:center;width:42px;height:42px;border-radius:13px;background:#eff6ff;color:#2563eb;font-size:1.5rem;font-weight:800}.file-picker>span:last-of-type{color:#64748b;font-size:.86rem}.file-picker input{max-width:100%;margin-top:8px}.file-preview{padding:12px 14px;border-radius:11px;background:#f8fafc;font-size:.9rem;overflow-wrap:anywhere}.tool-panel button{border:0;border-radius:12px;background:#2563eb;color:#fff;padding:14px 20px;font:inherit;font-weight:750;cursor:pointer}.tool-panel button:disabled{opacity:.45;cursor:not-allowed}.status{margin:0}.privacy-hint{margin:0;color:#64748b;font-size:.84rem}.info-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:30px}.info-grid article{padding:23px;border:1px solid #e2e8f0;border-radius:17px}.info-grid h2,.faq h2{font-size:1.25rem;margin:8px 0 12px}.info-grid p,.info-grid li,.faq p{color:#64748b}.info-grid ol{padding-left:20px}.info-grid li{margin:8px 0}.faq{margin:38px 0 10px}.faq details{padding:16px 0;border-bottom:1px solid #e2e8f0}.faq summary{cursor:pointer;font-weight:700}.faq p{margin:9px 0 0}.tool-panel button:hover{background:#1d4ed8}@media(max-width:650px){.tool-panel{padding:20px}.info-grid{grid-template-columns:1fr}}
  </style>
  <script>
    import { jsPDF } from "jspdf";
    const input=document.querySelector("#files"),button=document.querySelector("#convert"),preview=document.querySelector("#preview"),status=document.querySelector("#status");let files=[];
    input.addEventListener("change",()=>{files=Array.from(input.files||[]).filter(f=>f.type.startsWith("image/"));preview.textContent=files.length?files.map(f=>f.name).join(" • "):"Nenhuma imagem válida selecionada.";button.disabled=!files.length;status.textContent="";});
    button.addEventListener("click",async()=>{if(!files.length)return;button.disabled=true;status.textContent="Preparando PDF...";try{const pdf=new jsPDF({orientation:"portrait",unit:"pt",format:"a4"});for(let i=0;i<files.length;i++){const url=URL.createObjectURL(files[i]);try{const img=new Image();img.src=url;await img.decode();if(i)pdf.addPage();const w=pdf.internal.pageSize.getWidth(),h=pdf.internal.pageSize.getHeight(),scale=Math.min(w/img.width,h/img.height);const canvas=document.createElement("canvas");canvas.width=img.naturalWidth;canvas.height=img.naturalHeight;const context=canvas.getContext("2d");if(!context)throw new Error("Canvas indisponível");context.fillStyle="#ffffff";context.fillRect(0,0,canvas.width,canvas.height);context.drawImage(img,0,0);const jpeg=canvas.toDataURL("image/jpeg",0.92);pdf.addImage(jpeg,"JPEG",(w-img.width*scale)/2,(h-img.height*scale)/2,img.width*scale,img.height*scale);}finally{URL.revokeObjectURL(url);}}pdf.save("imagens-arquivopronto.pdf");status.textContent="PDF criado e baixado com sucesso.";}catch(e){status.textContent="Não foi possível converter. Tente imagens JPG ou PNG menores.";}finally{button.disabled=false;}});
  </script>
</BaseLayout>
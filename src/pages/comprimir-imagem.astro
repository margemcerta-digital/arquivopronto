---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Comprimir imagem | ArquivoPronto" description="Comprima imagens JPG, PNG e WebP gratuitamente no navegador.">
  <span class="eyebrow">Ferramenta gratuita</span><h1 class="page-title">Comprimir imagem</h1><p class="lead">Reduza o tamanho de uma imagem para facilitar o envio e compartilhamento.</p>
  <section class="tool-panel"><label for="file"><strong>Selecione uma imagem</strong></label><input id="file" type="file" accept="image/jpeg,image/png,image/webp" /><label for="quality">Qualidade: <strong id="qualityValue">75%</strong></label><input id="quality" type="range" min="20" max="95" value="75" /><button id="run" disabled>Comprimir imagem</button><p id="status" class="muted" aria-live="polite"></p><a id="download" hidden>Baixar imagem comprimida</a></section>
  <style>.tool-panel{display:grid;gap:16px}.tool-panel input[type=file]{padding:14px;border:1px dashed #94a3b8;border-radius:12px}button{border:0;border-radius:12px;background:#2563eb;color:white;padding:14px 20px;font-weight:700;cursor:pointer}button:disabled{opacity:.45}a{font-weight:700}</style>
  <script>
    import imageCompression from "browser-image-compression";
    const fileInput=document.querySelector("#file"),quality=document.querySelector("#quality"),qualityValue=document.querySelector("#qualityValue"),run=document.querySelector("#run"),status=document.querySelector("#status"),download=document.querySelector("#download");let selected=null,downloadUrl=null;
    quality.addEventListener("input",()=>qualityValue.textContent=quality.value+"%");
    fileInput.addEventListener("change",()=>{selected=fileInput.files?.[0]||null;run.disabled=!selected;download.hidden=true;status.textContent=selected?"Original: "+(selected.size/1024).toFixed(0)+" KB":"";if(downloadUrl)URL.revokeObjectURL(downloadUrl);});
    run.addEventListener("click",async()=>{if(!selected)return;run.disabled=true;status.textContent="Comprimindo no navegador...";try{const result=await imageCompression(selected,{maxSizeMB:5,maxWidthOrHeight:2560,useWebWorker:true,initialQuality:Number(quality.value)/100});if(downloadUrl)URL.revokeObjectURL(downloadUrl);downloadUrl=URL.createObjectURL(result);download.href=downloadUrl;download.download="comprimida-"+selected.name.replace(/\\.[^.]+$/,"")+".jpg";download.hidden=false;status.textContent="Concluído: "+(selected.size/1024).toFixed(0)+" KB → "+(result.size/1024).toFixed(0)+" KB.";}catch(e){status.textContent="Não foi possível comprimir este arquivo. Tente outra imagem.";}finally{run.disabled=false;}});
  </script>
</BaseLayout>
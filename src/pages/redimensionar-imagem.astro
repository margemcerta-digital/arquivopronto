---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Redimensionar imagem | ArquivoPronto" description="Redimensione imagens gratuitamente, definindo largura e altura em pixels.">
  <span class="eyebrow">Ferramenta gratuita</span><h1 class="page-title">Redimensionar imagem</h1><p class="lead">Defina novas dimensões em pixels e baixe sua imagem redimensionada.</p>
  <section class="tool-panel"><label for="file"><strong>Escolha uma imagem</strong></label><input id="file" type="file" accept="image/*" /><div class="dimensions"><label>Largura (px)<input id="width" type="number" min="1" max="10000" /></label><label>Altura (px)<input id="height" type="number" min="1" max="10000" /></label></div><label class="check"><input id="ratio" type="checkbox" checked /> Manter proporção</label><button id="run" disabled>Redimensionar e baixar</button><p id="status" class="muted" aria-live="polite"></p></section>
  <style>.tool-panel{display:grid;gap:16px}.tool-panel input[type=file]{padding:14px;border:1px dashed #94a3b8;border-radius:12px}.dimensions{display:grid;grid-template-columns:1fr 1fr;gap:14px}.dimensions label{display:grid;gap:6px;font-weight:600}.dimensions input{padding:12px;border:1px solid #cbd5e1;border-radius:9px}.check{display:flex;align-items:center;gap:8px}button{border:0;border-radius:12px;background:#2563eb;color:white;padding:14px 20px;font-weight:700;cursor:pointer}button:disabled{opacity:.45}</style>
  <script>
    const fileInput=document.querySelector("#file"),widthInput=document.querySelector("#width"),heightInput=document.querySelector("#height"),ratio=document.querySelector("#ratio"),run=document.querySelector("#run"),status=document.querySelector("#status");let image=null,originalRatio=1,objectUrl=null;
    fileInput.addEventListener("change",async()=>{const file=fileInput.files?.[0];if(!file)return;try{if(objectUrl)URL.revokeObjectURL(objectUrl);objectUrl=URL.createObjectURL(file);image=new Image();image.src=objectUrl;await image.decode();originalRatio=image.width/image.height;widthInput.value=image.width;heightInput.value=image.height;run.disabled=false;status.textContent="Original: "+image.width+" × "+image.height+" px";}catch(e){status.textContent="Não foi possível abrir esta imagem.";run.disabled=true;}});
    widthInput.addEventListener("input",()=>{if(ratio.checked&&image&&widthInput.value)heightInput.value=Math.round(Number(widthInput.value)/originalRatio);});heightInput.addEventListener("input",()=>{if(ratio.checked&&image&&heightInput.value)widthInput.value=Math.round(Number(heightInput.value)*originalRatio);});
    run.addEventListener("click",()=>{const w=Number(widthInput.value),h=Number(heightInput.value);if(!image||!Number.isInteger(w)||!Number.isInteger(h)||w<1||h<1||w>10000||h>10000){status.textContent="Informe largura e altura válidas entre 1 e 10.000 pixels.";return;}const canvas=document.createElement("canvas");canvas.width=w;canvas.height=h;canvas.getContext("2d").drawImage(image,0,0,w,h);canvas.toBlob(blob=>{if(!blob){status.textContent="Falha ao gerar a imagem.";return;}const url=URL.createObjectURL(blob),a=document.createElement("a");a.href=url;a.download="imagem-redimensionada.png";a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);status.textContent="Imagem pronta: "+w+" × "+h+" px.";},"image/png");});
  </script>
</BaseLayout>
---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
interface Props { title: string; description: string; canonical?: string; }
const { title, description, canonical } = Astro.props;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#2563eb" />
    <meta name="google-adsense-account" content="ca-pub-7942664206271443" />
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7942664206271443" crossorigin="anonymous"></script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-132B74FRQZ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag("js", new Date());
      gtag("config", "G-132B74FRQZ");
    </script>
    <title>{title}</title>
    <slot name="head" />
    <style is:global>
      :root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#172554;background:#fff;font-synthesis:none;text-rendering:optimizeLegibility}*{box-sizing:border-box}body{margin:0;line-height:1.6}a{color:#2563eb}main{max-width:1120px;margin:0 auto;padding:36px 24px 0}.eyebrow{color:#2563eb;font-size:.78rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.page-title{font-size:clamp(2rem,5vw,3.3rem);line-height:1.12;letter-spacing:-.04em;margin:.5rem 0 1rem}.lead{font-size:1.12rem;color:#64748b;max-width:720px}.tool-panel{margin-top:30px;padding:28px;border:1px solid #e2e8f0;border-radius:20px;background:#fff;box-shadow:0 12px 40px rgba(15,23,42,.05)}.muted{color:#64748b}
    </style>
  </head>
  <body><Header /><main><slot /></main><Footer /></body>
</html>
